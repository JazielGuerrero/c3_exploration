const int GAMEPAD_BUTTON_A               =0;
const int GAMEPAD_BUTTON_B               =1;
const int GAMEPAD_BUTTON_X               =2;
const int GAMEPAD_BUTTON_Y               =3;
const int GAMEPAD_BUTTON_LEFT_BUMPER     =4;
const int GAMEPAD_BUTTON_RIGHT_BUMPER    =5;
