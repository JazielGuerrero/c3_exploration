 */
const int MOUSE_PASSTHROUGH      =0x0002000D;

/*! @brief Initial position x-coordinate window hint.
 *
 *  Initial position x-coordinate [window hint](@ref POSITION_X).
 */
const int POSITION_X             =0x0002000E;

/*! @brief Initial position y-coordinate window hint.
 *
 *  Initial position y-coordinate [window hint](@ref POSITION_Y).
 */
const int POSITION_Y             =0x0002000F;

/*! @brief Framebuffer bit depth hint.
 *
 *  Framebuffer bit depth [hint](@ref RED_BITS).
 */
const int RED_BITS               =0x00021001;
/*! @brief Framebuffer bit depth hint.
 *
 *  Framebuffer bit depth [hint](@ref GREEN_BITS).
 */
const int GREEN_BITS             =0x00021002;
/*! @brief Framebuffer bit depth hint.
 *
 *  Framebuffer bit depth [hint](@ref BLUE_BITS).
 */
const int BLUE_BITS              =0x00021003;
/*! @brief Framebuffer bit depth hint.
 *
 *  Framebuffer bit depth [hint](@ref ALPHA_BITS).
 */
const int ALPHA_BITS             =0x00021004;
/*! @brief Framebuffer bit depth hint.
 *
 *  Framebuffer bit depth [hint](@ref DEPTH_BITS).
 */
const int DEPTH_BITS             =0x00021005;
/*! @brief Framebuffer bit depth hint.
 *
