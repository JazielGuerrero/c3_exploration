const int MOUSE_BUTTON_LAST      =MOUSE_BUTTON_8;
const int MOUSE_BUTTON_LEFT      =MOUSE_BUTTON_1;
const int MOUSE_BUTTON_RIGHT     =MOUSE_BUTTON_2;
const int MOUSE_BUTTON_MIDDLE    =MOUSE_BUTTON_3;
