 *  [window attribute](@ref RESIZABLE_attrib).
 */
const int RESIZABLE              =0x00020003;
/*! @brief Window visibility window hint and attribute
 *
 *  Window visibility [window hint](@ref VISIBLE_hint) and
 *  [window attribute](@ref VISIBLE_attrib).
 */
const int VISIBLE                =0x00020004;
/*! @brief Window decoration window hint and attribute
 *
 *  Window decoration [window hint](@ref DECORATED_hint) and
 *  [window attribute](@ref DECORATED_attrib).
 */
const int DECORATED              =0x00020005;
/*! @brief Window auto-iconification window hint and attribute
 *
 *  Window auto-iconification [window hint](@ref AUTO_ICONIFY_hint) and
