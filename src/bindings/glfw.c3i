 */
const int TRANSPARENT_FRAMEBUFFER =0x0002000A;
/*! @brief Mouse cursor hover window attribute.
 *
 *  Mouse cursor hover [window attribute](@ref HOVERED_attrib).
 */
const int HOVERED                =0x0002000B;
/*! @brief Input focus on calling show window hint and attribute
 *
 *  Input focus [window hint](@ref FOCUS_ON_SHOW_hint) or
 *  [window attribute](@ref FOCUS_ON_SHOW_attrib).
 */
const int FOCUS_ON_SHOW          =0x0002000C;

/*! @brief Mouse input transparency window hint and attribute
 *
 *  Mouse input transparency [window hint](@ref MOUSE_PASSTHROUGH_hint) or
